# Copy to .env and fill in (never commit .env).
# Local dev works with everything commented out (JSON files + memory sessions).

# ---- MongoDB (REQUIRED on Vercel — its filesystem forgets JSON data) ----
# Atlas setup: create a free cluster -> Database Access: add a db user
# (readWrite on growkrishak) -> Network Access: allow 0.0.0.0/0 (Vercel IPs
# change, so allow-all is required) -> Connect: "Drivers / Node.js" string.
# Setting this switches BOTH data storage AND login sessions to MongoDB.
# Keep the /growkrishak database name in the URI. Encode special chars in
# the password (@ -> %40, / -> %2F, etc.).
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/growkrishak?retryWrites=true&w=majority

# Signs session cookies / server sessions. REQUIRED in production —
# generate a long random string (sessions break on redeploy without it).
# SESSION_SECRET=change-me-to-a-long-random-string

# Fixed port (default: auto-try 3000-3005).
# PORT=3000

# Override JSON data directory (used when MONGODB_URI is not set).
# DATA_DIR=./data

# Force session type: memory | cookie (default: memory locally, cookie on Vercel).
# SESSION_STORE=memory

# Main admin login (used by admin.html -> POST /api/admin/login).
# ADMIN_EMAIL=admin@growkrishak.com
# ADMIN_PASSWORD=Admin@123
