{
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "*.html",
        "*.png",
        "robots.txt"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}